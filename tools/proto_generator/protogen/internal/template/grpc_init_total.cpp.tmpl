#include "grpc_init_client.h"

#include <chrono>
#include <cstdint>
#include <proto/common/base/node.pb.h>
#include <proto/common/base/common.pb.h>

{{ range .GrpcFiles }}
{{/* 无 package 时保持全局声明,与其他编译单元的定义一致。 */}}
{{if .CppPackage}}namespace {{.CppPackage}} {{"{"}}{{end}}
    void Set{{.FileBaseNameCamel}}CallDeadline(std::chrono::milliseconds deadline);
{{if .CppPackage}}{{"}"}}{{end}}
{{ end }}

{{/* 同一节点类型可能有多个 gRPC 文件(battle_node + player_battle):互相独立的 if,不能写成 else if。 */}}
void SetGrpcCallDeadline(uint32_t nodeType, std::chrono::milliseconds deadline){
{{- range $file := .GrpcFiles }}
    if (static_cast<uint32_t>({{$.NodeEnumCppType}}::{{$file.NodeServiceForCpp}}NodeService) == nodeType) {
        {{$file.CppPackage}}::Set{{$file.FileBaseNameCamel}}CallDeadline(deadline);
    }
{{- end }}
}
