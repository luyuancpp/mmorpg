#pragma once
#include <chrono>
#include <string_view>
#include "entt/src/entt/entity/registry.hpp"
#include "grpc_client/grpc_call_tag.h"
{{- /* 消息类型来自服务元数据头;传输不依赖官方 gRPC 生成头。 */}}
{{ range $index, $m := .ServiceInfo }}
  {{- if eq $index 0 }}
{{$m.ServiceInfoIncludeName}}
  {{- end }}
{{- end }}

{{/* 无 package 的服务公开声明必须留在全局命名空间。 */}}
{{if .Package}}namespace {{.Package}} {{"{"}}{{end}}
{{- range $svc := .ServiceInfo }}
{{- range $method := $svc.Methods }}
#pragma region {{ $svc.Service }}{{ $method.Method }}
// gRPC :path(线上契约,与 Go 侧一致)。
inline constexpr std::string_view k{{ $svc.Service }}{{ $method.Method }}GrpcPath = "/{{ if $svc.Package }}{{ $svc.Package }}.{{ end }}{{ $svc.Service }}/{{ $method.Method }}";
{{- if or $method.ClientStreaming $method.ServerStreaming }}
// 流式方法不生成 Send,也不进入元数据 sender;etcd 流由 MuduoEtcdTransport 手写。
{{- else }}
// done 必填且恰好调用一次,从不在 Send 栈内同步调用;为空 LOG_FATAL。响应只在回调期间有效。
void Send{{ $svc.Service }}{{ $method.Method }}(entt::registry& registry, entt::entity nodeEntity, const {{ $method.CppRequest }}& request, GrpcDone<{{ $method.CppResponse }}> done, const GrpcCallOptions& options = {});
// 类型擦除版只供元数据 sender 使用;动态类型不匹配时异步回 INTERNAL,不发出请求。
void Send{{ $svc.Service }}{{ $method.Method }}Erased(entt::registry& registry, entt::entity nodeEntity, const google::protobuf::Message& message, GrpcMessageDone done, const GrpcCallOptions& options);
{{- end }}
#pragma endregion
{{- end }}
{{- end }}

{{- range $index, $svc := .ServiceInfo }}
  {{- if eq $index 0 }}
// 本文件所有 unary 调用此后使用的 deadline;启动时按目标节点类型设置。
void Set{{$svc.FileBaseNameCamel}}CallDeadline(std::chrono::milliseconds deadline);
  {{- end }}
{{- end }}

{{if .Package}}{{"}"}}// namespace {{.Package}}{{end}}
