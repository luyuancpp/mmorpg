grpc::Status {{ $.Service }}Impl::{{ .HandlerName }}(grpc::ServerContext* /*context*/,
    const {{ .CppRequest }}* request,
    {{ .CppResponse }}*{{ if .IsVoidResponse }} /*response*/{{ else }} response{{ end }})
{
{{ .PreDispatchCode }}
    std::promise<grpc::Status> promise;
    auto future = promise.get_future();

    // future.get() 覆盖整个任务寿命；自定义段需要的成员引用应在投递前绑定，避免捕获 this。
