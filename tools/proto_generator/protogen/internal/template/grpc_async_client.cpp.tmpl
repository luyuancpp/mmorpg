Async{{ $svc.Service }}{{ $method.Method }}HandlerFunctionType Async{{ $svc.Service }}{{ $method.Method }}Handler;
Async{{ $svc.Service }}{{ $method.Method }}FailedHandlerFunctionType Async{{ $svc.Service }}{{ $method.Method }}FailedHandler;

namespace {
// 一次调用的状态:随完成回调走(shared_ptr),不进 ECS、不放对象池。
// request 必须是副本:gate 通用路径发出的是 gRpcMethodRegistry 里的共享原型,下一条客户端消息就会覆盖它。
struct {{ $svc.Service }}{{ $method.Method }}Call {
    {{ $method.CppRequest }} request;
    GrpcSentMetadata sentMetadata;
    // 每次调用回调;为空时走全局 Async{{ $svc.Service }}{{ $method.Method }}Handler / FailedHandler。
    GrpcDone<{{ $method.CppResponse }}> done;
};

void Complete{{ $svc.Service }}{{ $method.Method }}(const {{ $svc.Service }}{{ $method.Method }}Call& call, const GrpcCallOutcome& outcome,
                                                const {{ $method.CppResponse }}* reply) {
    if (call.done) {
        // 带每次调用回调的调用只交给它,不再走全局应答 / 失败处理器。reply 只在回调期间有效。
        call.done(outcome, outcome.ok() ? reply : nullptr);
        return;
    }
    if (outcome.ok()) {
        if (Async{{ $svc.Service }}{{ $method.Method }}Handler) {
            Async{{ $svc.Service }}{{ $method.Method }}Handler(outcome, *reply);
        } else {
            // 应答到了却没人收:2026-04 起换图应答就是这样静默丢了约 5 个月。每个方法每线程报一次;
            // 确实不需要应答的调用方显式装一个空处理器。
            thread_local bool reportedMissingHandler = false;
            if (!reportedMissingHandler) {
                reportedMissingHandler = true;
                LOG_ERROR << "gRPC {{ $svc.Service }}.{{ $method.Method }} reply dropped: Async{{ $svc.Service }}{{ $method.Method }}Handler is not installed"
                          << " (install one, or an empty one if the reply is intentionally ignored)";
            }
        }
    } else if (Async{{ $svc.Service }}{{ $method.Method }}FailedHandler) {
        const GrpcCallFailure failure{ {{ $svc.Service }}{{ $method.Method }}MessageId, "{{ $svc.Service }}.{{ $method.Method }}", outcome, call.sentMetadata};
        Async{{ $svc.Service }}{{ $method.Method }}FailedHandler(failure, call.request);
    } else {
        LOG_ERROR << "gRPC {{ $svc.Service }}.{{ $method.Method }} failed: code=" << outcome.code << " msg=" << outcome.message;
    }
}

void QueueLocal{{ $svc.Service }}{{ $method.Method }}Failure(std::shared_ptr<{{ $svc.Service }}{{ $method.Method }}Call> call, uint32_t code, std::string message) {
    QueueGrpcLocalCompletion([call = std::move(call), outcome = LocalFailure(code, std::move(message))] {
        Complete{{ $svc.Service }}{{ $method.Method }}(*call, outcome, nullptr);
    });
}
}

// 所有 unary Send 重载的唯一发送入口。deadline <= 0 用本文件默认 deadline;done 为空走全局处理器。
void Start{{ $svc.Service }}{{ $method.Method }}Call(entt::registry& registry, entt::entity nodeEntity, const {{ $method.CppRequest }}& request,
                                             GrpcSentMetadata metadata, std::chrono::milliseconds deadline,
                                             GrpcDone<{{ $method.CppResponse }}> done) {
    auto call = std::make_shared<{{ $svc.Service }}{{ $method.Method }}Call>();
    call->request = request;
    call->sentMetadata = std::move(metadata);
    call->done = std::move(done);

    const auto channel = FindGrpcChannel(registry, nodeEntity);
    if (!channel) {
        QueueLocal{{ $svc.Service }}{{ $method.Method }}Failure(std::move(call), kGrpcStatusUnavailable, "node transport missing or closing");
        return;
    }
    muduo_grpc::UnaryCallRequest rpc;
    rpc.method = std::string(k{{ $svc.Service }}{{ $method.Method }}GrpcPath);
    if (!call->request.SerializeToString(&rpc.message)) {
        QueueLocal{{ $svc.Service }}{{ $method.Method }}Failure(std::move(call), kGrpcStatusInternal, "failed to serialize the request");
        return;
    }
    rpc.metadata.reserve(call->sentMetadata.size());
    for (const auto& [key, value] : call->sentMetadata) {
        // 应用层这一层 Base64 不能省:线上字节与改前一致,Go 侧按它解码、按原样回显(§4.2)。
        rpc.metadata.emplace_back(key, Base64Encode(value));
    }
    rpc.deadline = std::chrono::steady_clock::now() + (deadline.count() > 0 ? deadline : DefaultCallDeadline());
    channel->StartUnaryCall(std::move(rpc), [call](muduo_grpc::UnaryCallResult&& result) {
        GrpcCallOutcome outcome;
        outcome.code = result.status.code_value();
        outcome.message = result.status.message();
        outcome.initialMetadata = std::move(result.initialMetadata);
        outcome.trailingMetadata = std::move(result.trailingMetadata);
        if (!outcome.ok()) {
            Complete{{ $svc.Service }}{{ $method.Method }}(*call, outcome, nullptr);
            return;
        }
        {{ $method.CppResponse }} reply;
        if (!reply.ParseFromString(result.response)) {
            outcome.code = kGrpcStatusInternal;
            outcome.message = "failed to parse the {{ $svc.Service }}.{{ $method.Method }} response";
            Complete{{ $svc.Service }}{{ $method.Method }}(*call, outcome, nullptr);
            return;
        }
        Complete{{ $svc.Service }}{{ $method.Method }}(*call, outcome, &reply);
    });
}

void Send{{ $svc.Service }}{{ $method.Method }}(entt::registry& registry, entt::entity nodeEntity, const {{ $method.CppRequest }}& request,
                                            GrpcDone<{{ $method.CppResponse }}> done, const GrpcCallOptions& options) {
    Start{{ $svc.Service }}{{ $method.Method }}Call(registry, nodeEntity, request, options.metadata, options.deadline, std::move(done));
}

void Send{{ $svc.Service }}{{ $method.Method }}(entt::registry& registry, entt::entity nodeEntity, const {{ $method.CppRequest }}& request) {
    // 显式写出空 vector:另有 (request, GrpcDone, GrpcCallOptions) 重载,两个 {} 会有二义性。
    Send{{ $svc.Service }}{{ $method.Method }}(registry, nodeEntity, request, std::vector<std::string>{}, std::vector<std::string>{});
}

void Send{{ $svc.Service }}{{ $method.Method }}(entt::registry& registry, entt::entity nodeEntity, const {{ $method.CppRequest }}& request, const std::vector<std::string>& metaKeys, const std::vector<std::string>& metaValues) {
    const size_t count = std::min(metaKeys.size(), metaValues.size());
    GrpcSentMetadata metadata;
    metadata.reserve(count);
    for (size_t i = 0; i < count; ++i) {
        metadata.emplace_back(metaKeys[i], metaValues[i]);
    }
    Start{{ $svc.Service }}{{ $method.Method }}Call(registry, nodeEntity, request, std::move(metadata), std::chrono::milliseconds{0}, nullptr);
}

void Send{{ $svc.Service }}{{ $method.Method }}(entt::registry& registry, entt::entity nodeEntity, const google::protobuf::Message& message, const std::vector<std::string>& metaKeys, const std::vector<std::string>& metaValues) {
    const {{ $method.CppRequest }}& derived = static_cast<const {{ $method.CppRequest }}&>(message);
    Send{{ $svc.Service }}{{ $method.Method }}(registry, nodeEntity, derived, metaKeys, metaValues);
}
