void TryFinish{{ $svc.Service }}{{ $method.Method }}(Async{{ $svc.Service }}{{ $method.Method }}GrpcClient& client) {
    if (!(client.closing || client.runtime->closing) || client.initializing || client.reading ||
        client.writing || client.finishing || client.finished) {
        return;
    }
    client.finishing = true;
    GrpcTag* tag = tagPool.construct({{ $svc.Service }}{{ $method.Method }}MessageId, (void*)GrpcOperation::FINISH);
    client.stream->Finish(&client.status, tag);
}

void TryWriteNextNext{{ $svc.Service }}{{ $method.Method }}(Async{{ $svc.Service }}{{ $method.Method }}GrpcClient& client) {
    if (client.initializing || client.writing || client.closing || client.runtime->closing ||
        client.finishing || client.finished || client.pendingWrites.empty()) {
        return;
    }
    // 不把可淘汰的队列元素地址交给异步 Write。
    client.writingRequest.Swap(&client.pendingWrites.front());
    client.pendingWrites.pop_front();
    client.writing = true;
    GrpcTag* tag = tagPool.construct({{ $svc.Service }}{{ $method.Method }}MessageId, (void*)GrpcOperation::WRITE);
    client.stream->Write(client.writingRequest, tag);
}

void AsyncCompleteGrpc{{ $svc.Service }}{{ $method.Method }}(entt::registry& registry, entt::entity nodeEntity,
                                                         grpc::CompletionQueue&, bool ok, void* got_tag) {
    auto* client = registry.try_get<Async{{ $svc.Service }}{{ $method.Method }}GrpcClient>(nodeEntity);
    if (client == nullptr) {
        LOG_ERROR << "gRPC stream owner disappeared before completion";
        return;
    }
    const auto operation = static_cast<GrpcOperation>(reinterpret_cast<intptr_t>(got_tag));
    if (!ok && operation != GrpcOperation::FINISH) {
        client->closing = true;
        client->context.TryCancel();
    }
    switch (operation) {
        case GrpcOperation::WRITE:
            client->writing = false;
            client->writingRequest.Clear();
            break;
        case GrpcOperation::READ: {
            // Read 已完成，但业务 handler 仍借用 reply；保持 reading，禁止重入 WRITE 再排 Read/Finish。
            struct ReadBorrow {
                entt::registry& registry;
                entt::entity entity;
                ~ReadBorrow() {
                    if (!registry.valid(entity)) return;
                    if (auto* owner = registry.try_get<Async{{ $svc.Service }}{{ $method.Method }}GrpcClient>(entity)) {
                        owner->reading = false;
                    }
                }
            };
            try {
                const ReadBorrow borrow{registry, nodeEntity};
                if (ok && !client->closing && !client->runtime->closing && Async{{ $svc.Service }}{{ $method.Method }}Handler) {
                    Async{{ $svc.Service }}{{ $method.Method }}Handler(client->context, client->reply);
                }
            } catch (...) {
                if (registry.valid(nodeEntity)) {
                    if (auto* owner = registry.try_get<Async{{ $svc.Service }}{{ $method.Method }}GrpcClient>(nodeEntity)) {
                        owner->closing = true;
                        owner->context.TryCancel();
                        TryFinish{{ $svc.Service }}{{ $method.Method }}(*owner);
                    }
                }
                throw;
            }
            // 应答处理器可能重入关闭节点，借用结束后重取句柄再继续。
            if (!registry.valid(nodeEntity)) return;
            client = registry.try_get<Async{{ $svc.Service }}{{ $method.Method }}GrpcClient>(nodeEntity);
            if (client == nullptr) return;
            break;
        }
        case GrpcOperation::INIT:
            client->initializing = false;
            break;
        case GrpcOperation::FINISH:
            client->finished = true;
            client->runtime->calls.erase(&client->context);
            client->pendingWrites.clear();
            if (!client->status.ok() && !client->runtime->closing) {
                LOG_ERROR << "gRPC {{ $svc.Service }}.{{ $method.Method }} stream ended: " << client->status.error_message();
            }
            return;
        default:
            break;
    }
    if (!client->initializing && !client->reading && !client->closing && !client->runtime->closing) {
        client->reply.Clear();
        client->reading = true;
        GrpcTag* tag = tagPool.construct({{ $svc.Service }}{{ $method.Method }}MessageId, (void*)GrpcOperation::READ);
        client->stream->Read(&client->reply, tag);
    }
    TryWriteNextNext{{ $svc.Service }}{{ $method.Method }}(*client);
    TryFinish{{ $svc.Service }}{{ $method.Method }}(*client);
}
{{ else }}
void Complete{{ $svc.Service }}{{ $method.Method }}(Async{{ $svc.Service }}{{ $method.Method }}GrpcClient* call) {
    // 回调可能重入关闭/排空；context 登记与调用对象必须一起保留到业务回调退栈。
    const auto release = [](Async{{ $svc.Service }}{{ $method.Method }}GrpcClient* completed) {
        if (completed->runtime) completed->runtime->calls.erase(&completed->context);
        {{ $svc.Service }}{{ $method.Method }}Pool.destroy(completed);
    };
    const std::unique_ptr<Async{{ $svc.Service }}{{ $method.Method }}GrpcClient, decltype(release)> owner(call, release);
    if (call->done) {
        // 带每次调用回调的调用只交给它,不再走全局应答 / 失败处理器。reply 借自调用对象,回调退栈后才释放。
        const GrpcCallOutcome outcome{static_cast<uint32_t>(call->status.error_code()), call->status.error_message()};
        call->done(outcome, call->status.ok() ? &call->reply : nullptr);
        return;
    }
    if (call->status.ok()) {
        if (Async{{ $svc.Service }}{{ $method.Method }}Handler) {
            Async{{ $svc.Service }}{{ $method.Method }}Handler(call->context, call->reply);
        } else {
            // 应答到了却没人收:2026-04 起换图应答就是这样静默丢了约 5 个月。每个方法每线程报一次;
            // 确实不需要应答的调用方显式装一个空处理器。
            thread_local bool reportedMissingHandler = false;
            if (!reportedMissingHandler) {
                reportedMissingHandler = true;
                LOG_ERROR << "gRPC {{ $svc.Service }}.{{ $method.Method }} reply dropped: Async{{ $svc.Service }}{{ $method.Method }}Handler is not installed"
                          << " (install one, or an empty one if the reply is intentionally ignored)";
            }
        }
    } else if (Async{{ $svc.Service }}{{ $method.Method }}FailedHandler) {
        const GrpcCallFailure failure{call->messageId, "{{ $svc.Service }}.{{ $method.Method }}", call->context, call->status, call->sentMetadata};
        Async{{ $svc.Service }}{{ $method.Method }}FailedHandler(failure, call->request);
    } else {
        LOG_ERROR << "gRPC {{ $svc.Service }}.{{ $method.Method }} failed: code=" << static_cast<int>(call->status.error_code())
                  << " msg=" << call->status.error_message();
    }

}

void AsyncCompleteGrpc{{ $svc.Service }}{{ $method.Method }}(entt::registry&, entt::entity,
                                                         grpc::CompletionQueue&, bool ok, void* got_tag) {
    auto* call = static_cast<Async{{ $svc.Service }}{{ $method.Method }}GrpcClient*>(got_tag);
    if (!ok && call->status.ok()) {
        call->status = Status(grpc::StatusCode::CANCELLED, "completion cancelled");
    }
    Complete{{ $svc.Service }}{{ $method.Method }}(call);
}

// 所有 unary Send 重载的唯一发送入口。deadline <= 0 用本文件默认 deadline;done 为空走全局处理器。
void Start{{ $svc.Service }}{{ $method.Method }}Call(entt::registry& registry, entt::entity nodeEntity, const {{ $method.CppRequest }}& request,
                                             GrpcSentMetadata metadata, std::chrono::milliseconds deadline,
                                             GrpcDone<{{ $method.CppResponse }}> done) {
    auto call({{ $svc.Service }}{{ $method.Method }}Pool.construct());
    for (const auto& [key, value] : metadata) {
        call->context.AddMetadata(key, Base64Encode(value));
    }
    call->sentMetadata = std::move(metadata);
    call->request = request;
    call->done = std::move(done);
    call->context.set_deadline(deadline.count() > 0 ? std::chrono::system_clock::now() + deadline : NextCallDeadline());
    auto* cq = registry.valid(nodeEntity) ? registry.try_get<grpc::CompletionQueue>(nodeEntity) : nullptr;
    auto* stub = registry.valid(nodeEntity) ? registry.try_get<{{ $svc.Service }}StubPtr>(nodeEntity) : nullptr;
    auto* runtime = registry.valid(nodeEntity) ? registry.try_get<GrpcClientRuntimePtr>(nodeEntity) : nullptr;
    if (runtime != nullptr) call->runtime = *runtime;
    if (cq == nullptr || stub == nullptr || !*stub || !call->runtime || call->runtime->closing) {
        call->status = Status(grpc::StatusCode::UNAVAILABLE, "node transport missing or closing");
        QueueGrpcClientCompletion(call->runtime, [call] { Complete{{ $svc.Service }}{{ $method.Method }}(call); });
        return;
    }
    call->runtime->calls.insert(&call->context);
    call->response_reader = (*stub)->PrepareAsync{{ $method.Method }}(&call->context, call->request, cq);
    call->response_reader->StartCall();
    GrpcTag* got_tag(tagPool.construct({{ $svc.Service }}{{ $method.Method }}MessageId, (void*)call));
    call->response_reader->Finish(&call->reply, &call->status, (void*)got_tag);
}

void Send{{ $svc.Service }}{{ $method.Method }}(entt::registry& registry, entt::entity nodeEntity, const {{ $method.CppRequest }}& request,
                                            GrpcDone<{{ $method.CppResponse }}> done, const GrpcCallOptions& options) {
    Start{{ $svc.Service }}{{ $method.Method }}Call(registry, nodeEntity, request, options.metadata, options.deadline, std::move(done));
}

