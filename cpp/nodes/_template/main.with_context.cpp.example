#include "muduo/net/EventLoop.h"

#include "node/system/etcd/etcd_transport.h"
#include "node/system/node/node_entry.h"

#include "handler/rpc/your_node_handler.h"
#include "handler/event/your_node_kafka_command_router.h"
#include "proto/contracts/kafka/your_node_command.pb.h"

using namespace muduo;
using namespace muduo::net;

namespace {

// Keep runtime-owned state here (timers, codecs, bridges, etc.).
struct YourNodeRuntimeContext {
    // TimerTaskComp timer;
};

struct YourNodeHooks {
    using KafkaCommandType = contracts::kafka::YourNodeCommand;
    // 必须显式指定生成的节点白名单路由,由路由直接调用 handler。
    // 新节点没有入口时,先在 protogen event_ingress.go 添加入口枚举与文件位置规则再生成。
    static void DispatchKafkaCommand(const std::string& topic, const KafkaCommandType& command)
    {
        DispatchYourNodeKafkaCommand(topic, command);
    }
};

} // namespace

int main(int argc, char* argv[])
{
    // Validate the legacy NODE_ETCD_TRANSPORT variable (etcd always uses muduo_h2 now) before the Node is constructed:
    // EtcdService::Init reads the installed factory inside the Node constructor.
    // See docs/design/grpc-muduo-transport.md section 13.4.
    etcd_transport::InstallFromEnv();
    return node::entry::RunSimpleNodeMainWithOwnedContext<YourNodeHandler, YourNodeRuntimeContext, YourNodeHooks>(
        YourNodeService,
        Node::CanConnectNodeTypeList{ /* SceneNodeService, LoginNodeService, ... */ },
        [](Node& node, YourNodeRuntimeContext& context) {
            // Optional: node lifecycle callbacks.
            node.SetAfterStart([&context](Node& n) {
                // Example: context.timer.RunEvery(1.0, [] {});
                // (void)n;
            });
        });
}
